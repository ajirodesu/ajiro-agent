{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ajiro-agent/app.schema.json",
  "title": "Ajiro Agent preview-relevant Expo config surface",
  "description": "Minimal contract for the app.json fields Web Preview and OTA depend on. Enforced by npm run contracts:check.",
  "type": "object",
  "required": ["expo"],
  "properties": {
    "expo": {
      "type": "object",
      "required": ["name", "slug", "version", "platforms", "runtimeVersion"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "enum": ["android", "ios", "web"] },
          "requiredWebPlatform": true
        },
        "runtimeVersion": {
          "type": "object",
          "required": ["policy"],
          "properties": {
            "policy": { "type": "string", "enum": ["appVersion", "sdkVersion"] }
          }
        },
        "updates": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
